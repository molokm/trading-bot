# OKX API credentials (demo or live)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=true

BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Dashboard security
SESSION_SECRET=
DASHBOARD_PASSWORD=
TOKEN_ENCRYPTION_KEY=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paid signals: private channel the bot broadcasts signals to (must be bot admin).
# TELEGRAM_CHANNEL_ID=-1001234567890
# SIGNAL_PRICE_STARS=100
# SIGNAL_PLAN_DAYS=30
# SIGNAL_INVITE_DAYS=3

# Pro plan — mini-app + user's own OKX account (multi-tenant).
# PRO_PRICE_STARS=500
# PRO_PLAN_DAYS=30

# Analysis log file (JSONL, one event per line).
# Default: <backend>/logs/analysis.jsonl
ANALYSIS_LOG_PATH=
# Optional dedicated JWT secret (else TOKEN_ENCRYPTION_KEY / DASHBOARD_PASSWORD)
# JWT_SECRET=
