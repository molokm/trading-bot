# Минимальный шаблон для запуска бэкенда локально.
# Полный список переменных (риск-лимиты, LLM, Pro-тариф, cookie-сессии) —
# в корневом ../.env.example — он источник правды. Скопируйте этот файл в .env:
#   cp backend/.env.example backend/.env

# OKX API credentials (demo or live)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=true

BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Dashboard security
DASHBOARD_PASSWORD=
TOKEN_ENCRYPTION_KEY=
# Optional dedicated JWT secret (else TOKEN_ENCRYPTION_KEY / DASHBOARD_PASSWORD)
# JWT_SECRET=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Канал бесплатных сигналов (бот должен быть админом канала)
# TELEGRAM_CHANNEL_ID=-1001234567890

# Pro plan — mini-app + user's own OKX account
# PRO_PRICE_STARS=500
# PRO_PLAN_DAYS=30

# Analysis log file (JSONL, one event per line).
# Default: <backend>/logs/analysis.jsonl
ANALYSIS_LOG_PATH=
