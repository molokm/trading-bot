//@version=5
strategy("Momentum ATR Trail", overlay=true,
  initial_capital=100, default_qty_type=strategy.percent_of_equity,
  default_qty_value=95, commission_value=0.05, commission_type=strategy.commission.percent)

emaLen     = input.int(200,  "EMA Trend")
swingLen   = input.int(30,   "Swing Window")
atrLen     = input.int(14,   "ATR Period")
atrMult    = input.float(2.0, "ATR Multiplier")

ema        = ta.ema(close, emaLen)
atr        = ta.atr(atrLen)

swingHigh  = ta.pivothigh(high, swingLen, swingLen)
swingLow   = ta.pivotlow(low,   swingLen, swingLen)

uptrend    = close > ema
downtrend  = close < ema

momentumUp   = close > close[1]
momentumDown = close < close[1]

entryLong  = uptrend and not na(swingLow) and momentumUp
entryShort = downtrend and not na(swingHigh) and momentumDown

var float longStop  = na
var float shortStop = na

if entryLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    longStop := close - atr * atrMult

if entryShort and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    shortStop := close + atr * atrMult

if strategy.position_size > 0
    longStop := math.max(longStop, close - atr * atrMult)
    strategy.exit("XL", "Long", stop=longStop)

if strategy.position_size < 0
    shortStop := math.min(shortStop, close + atr * atrMult)
    strategy.exit("XS", "Short", stop=shortStop)

plot(ema, "EMA 200", color=color.new(#2962FF, 60), linewidth=2)
plotshape(series=swingHigh, title="Swing High", location=location.abovebar, color=color.new(#FF0000, 60), style=shape.triangledown, size=size.tiny)
plotshape(series=swingLow,  title="Swing Low",  location=location.belowbar, color=color.new(#00FF00, 60), style=shape.triangleup,   size=size.tiny)
