// ─── XGBoost inference ───
xgb_predict(f) =>
    score = 0.0
    for t = 0 to NUM_TREES - 1
        node = t * MAX_NODES
        left = array.get(LEFT_CHILDREN, node)
        while left != -1
            feat_idx = array.get(XGB_SPLIT_IDX, node)
            cond = array.get(XGB_SPLIT_COND, node)
            if array.get(f, feat_idx) <= cond
                node := array.get(LEFT_CHILDREN, node)
            else
                node := array.get(RIGHT_CHILDREN, node)
            left := array.get(LEFT_CHILDREN, node)
        score += array.get(XGB_WEIGHTS, node)
    1.0 / (1.0 + math.exp(-score))

// ─── Indicator calculations ───
close_val = close
high_val = high
low_val = low
vol_val = volume

// EMA trend (param ema_trend, default 200)
ema_trend_line = ta.ema(close_val, ema_trend)

// Swing highs/lows
sh = ta.pivothigh(high_val, swing_window, swing_window)
sl = ta.pivotlow(low_val, swing_window, swing_window)
csh = 0.0
csl = 0.0
csh := nz(sh, csh[1])
csl := nz(sl, csl[1])

// RSI(14) — SMA-based for strategy exit logic (match generate_signals)
// Pine ta.rsi uses RMA; we need SMA to match Python training
change_val = ta.change(close_val)
gain = math.max(change_val, 0)
loss = -math.min(change_val, 0)
avg_g_sma = ta.sma(gain, 14)
avg_l_sma = ta.sma(loss, 14)
rsi_val = 100.0 - 100.0 / (1.0 + avg_g_sma / math.max(avg_l_sma, 0.0001))

// RSI(14) — EMA-based for XGBoost feature (match _compute_entry_features)
avg_g_ema = ta.ema(gain, 14)
avg_l_ema = ta.ema(loss, 14)
rsi_ema = 100.0 - 100.0 / (1.0 + avg_g_ema / math.max(avg_l_ema, 0.0001))

// ATR(14) ratio (match Python: atr_pct = atr / close)
atr14 = ta.atr(14)
atr_ratio = atr14 / close_val

// MACD histogram
[macd_line, _, macd_hist] = ta.macd(close_val, 12, 26, 9)

// Bollinger Width (match Python: 4*std/sma)
bb_basis = ta.sma(close_val, 20)
bb_std = ta.stdev(close_val, 20)
bb_width = 4 * bb_std / bb_basis

// Volume ratio
vol_sma20 = ta.sma(vol_val, 20)
vol_ratio = vol_val / vol_sma20

// Distance from EMAs (match Python: ratio, not %)
ema50 = ta.ema(close_val, 50)
dist_ema200 = close_val / ema_trend_line - 1
dist_ema50 = close_val / ema50 - 1

// Swing range & dist (match Python: raw ratios)
swing_range = (csh - csl) / close_val
dist_to_swing = math.min(math.abs(close_val - csh), math.abs(close_val - csl)) / (atr14 + 0.0001)

// ─── Feature vector for XGBoost ───
f_arr = array.from(rsi_ema, atr_ratio, macd_hist, bb_width, vol_ratio, dist_ema200, dist_ema50, swing_range, dist_to_swing)

// ─── Signal logic ───
uptrend = close_val > ema_trend_line
downtrend = close_val < ema_trend_line

// Entry conditions (same as Python)
dropped = close_val < csh * 0.995
near_sl = close_val <= csl * 1.005
bounce = low_val > low_val[1]
long_entry = uptrend and dropped and near_sl and bounce

climbed = close_val > csl * 1.005
near_sh = close_val >= csh * 0.995
reject = high_val < high_val[1]
short_entry = downtrend and climbed and near_sh and reject

// Exit conditions
long_exit = close_val < csl or rsi_val > rsi_exit
short_exit = close_val > csh or rsi_val < (100 - rsi_exit)

// XGBoost gate
xgb_prob = xgb_predict(f_arr)
xgb_pass = xgb_prob >= xgb_threshold

// Final signals (with optional XGBoost)
buy_signal = long_entry and (not use_xgb or xgb_pass)
sell_signal = short_entry and (not use_xgb or xgb_pass)

// ─── Strategy execution ───
if buy_signal
    strategy.entry("Long", strategy.long)

if sell_signal
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0 and long_exit
    strategy.close("Long")

if strategy.position_size < 0 and short_exit
    strategy.close("Short")

// ─── Plots ───
plot(ema_trend_line, 'EMA Trend', color=color.blue, linewidth=1)
plotshape(buy_signal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(sell_signal, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
plot(csh, 'Swing High', color=color.gray, linewidth=1, style=plot.style_circles)
plot(csl, 'Swing Low', color=color.gray, linewidth=1, style=plot.style_circles)

// XGB debug plot in a separate pane
// @description XGBoost probability (in separate indicator pane)
hline(0.5, 'XGB Threshold', color=color.gray, linestyle=hline.style_dashed)
plot(xgb_prob, 'XGBoost Prob', color=color.purple, linewidth=2)