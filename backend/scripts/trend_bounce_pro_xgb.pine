//@version=6
strategy(
  title="Trend Bounce Pro w/ XGBoost",
  shorttitle="TB Pro XGB",
  overlay=true,
  initial_capital=1000,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=95,
  commission_type=strategy.commission.percent,
  commission_value=0.05,
  pyramiding=0)

// ─── Parameters ───
ema_trend = input.int(200, 'EMA Trend')
swing_window = input.int(40, 'Swing Window')
rsi_exit = input.int(80, 'RSI Exit')
xgb_threshold = input.float(0.5, 'XGBoost Threshold')
use_xgb = input.bool(true, 'Use XGBoost Gate')

// ─── Features & XGBoost arrays ───
MAX_NODES = 61
NUM_TREES = 200

