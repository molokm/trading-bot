//@version=5
strategy("Trend Bounce Pro", overlay=true,
  initial_capital=100, default_qty_type=strategy.percent_of_equity,
  default_qty_value=50, commission_value=0.1, commission_type=strategy.commission.percent)

emaTrendLen  = input.int(55, "EMA Trend")
swingWindow  = input.int(5,  "Swing Window")
rsiExitLen   = input.int(14, "RSI Exit")

emaTrend     = ta.ema(close, emaTrendLen)
emaFast      = ta.ema(close, emaTrendLen / 2)
emaSlow      = ta.ema(close, emaTrendLen * 3)

emaTrendUp   = emaTrend > emaTrend[1]
emaTrendDown = emaTrend < emaTrend[1]

bullish      = close > emaTrend
bearish      = close < emaTrend

aboveMA      = bullish
belowMA      = bearish

rsi          = ta.rsi(close, rsiExitLen)
rsiSafe      = rsi > 50
rsiOverbought = rsi > 70
rsiOversold   = rsi < 30

swingHigh    = ta.pivothigh(high, swingWindow, swingWindow)
swingLow     = ta.pivotlow(low,   swingWindow, swingWindow)

prevHigh     = ta.valuewhen(swingHigh, high[swingWindow], 0)
prevLow      = ta.valuewhen(swingLow,  low[swingWindow],  0)

pullbackLong = low <= prevLow and low > emaTrend and bullish
pullbackShort = high >= prevHigh and high < emaTrend and bearish

meanReversionExit = ta.crossunder(close, emaSlow)
rsiExitCond       = rsiOversold ? close > emaTrend : rsiOverbought ? close < emaTrend : false

entryCondition  = aboveMA and belowMA == false
longCond        = pullbackLong and rsiSafe
shortCond       = pullbackShort and rsiSafe == false

exitCondition   = belowMA or meanReversionExit or rsiExitCond

if entryCondition and longCond
    strategy.entry("Long", strategy.long)

if entryCondition and shortCond
    strategy.entry("Short", strategy.short)

if exitCondition
    strategy.close("Long")
    strategy.close("Short")

plot(emaTrend, "EMA Trend", color=color.new(#FF9800, 30), linewidth=2)
plotshape(series=swingHigh, title="Swing High", location=location.abovebar, color=color.new(#FF0000, 40), style=shape.triangledown, size=size.small)
plotshape(series=swingLow,  title="Swing Low",  location=location.belowbar, color=color.new(#00FF00, 40), style=shape.triangleup,   size=size.small)
