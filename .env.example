# OKX API Credentials (store locally, NEVER commit to git)
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here

# Demo mode: true = demo/simulated trading, false = real trading
OKX_DEMO=true

# Backend config
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# JWT secret for local session (change this)
SESSION_SECRET=change-me-to-random-string

# Neon PostgreSQL (for Render deployment)
# Get free connection string at https://console.neon.tech
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/trading?sslmode=require

# Dashboard password (for Render deployment).
# If set, users must enter this password to access dashboard controls.
# Guest mode (read-only) is available without password.
# DASHBOARD_PASSWORD=your_password_here

# Telegram trade notifications.
# Create a bot via @BotFather, get the token, then find your chat_id
# (e.g. via @userinfobot or @getmyid_bot).
# TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken
# TELEGRAM_CHAT_ID=123456789
