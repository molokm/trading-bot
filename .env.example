# ─────────────────────────────────────────────────────────────────────────────
# COPIX — переменные окружения (шаблон). Скопируйте в backend/.env и заполните.
# Полное описание интеграций — docs/ARCHITECTURE.md
# ─────────────────────────────────────────────────────────────────────────────

# ── OKX (единственная биржа) ──
# Ключи НИКОГДА не коммитить. Права: чтение + торговля (без вывода средств).
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here
# true = demo/simulated trading, false = реальные деньги
OKX_DEMO=true

# ── Backend ──
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
# Разрешить ручные ордера через /api/trade/order (по умолчанию запрещено)
# ALLOW_MANUAL_ORDERS=0

# ── Секреты, сессии, шифрование ──
# JWT для сессий (24 ч) — переживает рестарт и «сон» Render, если секрет стабилен.
# JWT_SECRET=
# Fernet-ключ для шифрования OKX-ключей пользователей в БД.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если не задан — ключ детерминированно выводится из JWT_SECRET или DASHBOARD_PASSWORD;
# если нет ни одного из трёх — сервис НЕ стартует (fail-closed).
# ⚠ Смена DASHBOARD_PASSWORD/JWT_SECRET при незаданном TOKEN_ENCRYPTION_KEY делает
#   ранее сохранённые ключи пользователей нечитаемыми.
TOKEN_ENCRYPTION_KEY=
# REQUIRE_ENCRYPTION_KEY=1   # требовать TOKEN_ENCRYPTION_KEY явно
DASHBOARD_PASSWORD=your_password_here
# Пароль обязателен: без него логин закрыт (fail-closed). Осознанный локальный
# вход без пароля — только явным флагом:
# ALLOW_NO_PASSWORD_LOGIN=1
# Сессии только в cookie (JWT не возвращается в теле ответа логина)
# COOKIE_ONLY_AUTH=0
# AUTH_COOKIE_SECURE=1
# AUTH_COOKIE_SAMESITE=lax

# ── База данных ──
# Пусто → локальный SQLite (backend/data/trading.db).
# Прод: Neon PostgreSQL, строка с sslmode=require.
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/trading?sslmode=require
# Ретенция истории (0 = хранить всё). >0 удаляет trades/exchange_close_trades/
# performance_metrics старше N дней на старте — только если упёрлись в квоту.
# DB_RETENTION_DAYS=0

# ── Telegram ──
# Бот создаётся через @BotFather; chat_id — через @userinfobot.
# TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken
# TELEGRAM_CHAT_ID=123456789
# Канал бесплатных сигналов (бот должен быть админом с правом приглашать)
# TELEGRAM_CHANNEL_ID=-1001234567890

# ── Подписки (Telegram Stars) ──
# Тариф Pro: мини-ап + торговля на своём счёте OKX. Тариф «Сигналы» выведен.
# PRO_PRICE_STARS=500
# PRO_PLAN_DAYS=30
# PRO_PLAN_LABEL=Pro-тариф: мини-ап + свой счёт OKX 1 мес

# ── Риск-контроль (0 = лимит выключен) ──
# RISK_KILL_SWITCH=false
# RISK_MAX_DAILY_LOSS_USD=   # абсолютный USD; дублирует AI daily_loss_limit_pct0
# RISK_MAX_WEEKLY_LOSS_USD=  # абсолютный USD; дублирует AI weekly_loss_limit_pct
# PNL_CLEAN_SLATE_ENABLE=0   # 1 = разрешить одноразовую очистку истории (опасно)
# RISK_MAX_POSITION_USD=0
# RISK_MAX_LEVERAGE=0
# Позиционные лимиты (этап 5)
# RISK_MAX_OPEN_POSITIONS=0
# RISK_MAX_POS_PER_SYMBOL=0
# RISK_MAX_CORRELATED_EXPOSURE_USD=0

# ── AI Discretionary 1H (LLM) ──
# Провайдеры: groq (primary) → openrouter → openai; без ключей — mock.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Провайдер: если не задан — автоопределение по ключам (groq → openrouter → openai).
# AI_LLM_PROVIDER=openai
# AI_LLM_MODEL=openai/gpt-oss-20b
# Для OpenAI-совместимых шлюзов (Gemini/OpenRouter-совместимые):
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...
# OPENAI_MODEL=gemini-3.5-flash-lite
# Цепочка запасных моделей при 429/404 (только OpenAI-совместимый провайдер):
# AI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# AI_LLM_FALLBACKS=openrouter,openai
# Payload обрезается только если реально больше лимита (по умолчанию 16000)
# AI_LLM_PAYLOAD_CHARS=16000
# AI_LLM_MAX_TOKENS=2048
# AI_LLM_REASONING_EFFORT=low
# Каденция LLM: в позиции и без позиции (сек)
# AI_LLM_MANAGE_SEC=90
# AI_LLM_MIN_SEC=180
# Жёсткий таймаут одного тика (сек)
# AI_TICK_TIMEOUT_SEC=120
# AI_FORCE_MODEL=
# AI_ALLOW_LARGE_MODEL=0
# Исполнение ордеров: 0 → только решения и логи (на demo разрешается автоматически)
# AI_EXECUTE=0
# AI_CAPITAL=10000
# AI_MAX_LEVERAGE=3
# AI_MAX_POSITIONS=2  # 2 = second slot (gated: green 1st trade + uncorrelated + align>=0.85)
# AI_RISK_PER_TRADE=0.012
# AI_DAILY_LOSS_LIMIT_PCT=0.02   # стоп новых входов после -2% дня
# AI_WEEKLY_LOSS_LIMIT_PCT=0.06  # ...и после -6% недели (MSK, пн 00:00)
# AI_POLL_SEC=60
# Кэпитал для сайзинга/PnL-базы (не equity счёта)
# AI_CAPITAL=10000
# ── Runtime guard (in-trade self-check) ──────────────────────────────────────
# Движок обязан доказывать, что управляет позицией (стопы/TP), а не только
# «тискать тики». Проверка: /api/health/guard
# AI_GUARD_ENABLE=1
# AI_GUARD_TICK_SEC=180          # тик не двигался дольше → crit
# AI_GUARD_MANAGE_SEC=300        # управление позициями не запускалось дольше → crit
# AI_GUARD_FLATTEN_SEC=1200      # без управления + в убытке дольше → закрыть
# AI_GUARD_NOTIFY_SEC=3600       # один дайджест в час (и редкие действия)
# AI Discretionary выключен по умолчанию (2026-11-24): владелец заглушил его,
# чтобы сфокусироваться на бумажном дневном трендовом портфеле.  Ставим 1,
# чтобы вернуть автостарт (или кнопкой Start в UI).
# AI_AUTO_START=0
# AI_FORCE_AUTOSTART=
# AI_PERSIST_USER_STOP=1
# Дебаты bull/bear на втором проходе LLM (заменяют повторный опрос, не дороже).
# 0 → обычный self-consistency.
# AI_DEBATE=1

# ── Автостарт ботов ──
# BOTS_AUTO_START=1     # общий выключатель автостарта
# MOM_AUTO_START=0      # Momentum — retired
# IMP_AUTO_START=0      # Impulse — retired
# VAL_AUTO_START=0      # Validation — retired
# SM_AUTO_START=0       # Smart Money — retired

# ── Дневной трендовый портфель (paper-only, только чтение) ──
# Лонг Donchian40/exit20/Chandelier 5xATR по 45 мейджорам. Модуль физически
# не умеет выставлять ордера — только публичные дневные свечи. По умолчанию
# ВЫКЛ. Честная база (один счёт, 7.9 лет, 0.16%/сторона, UTC): risk 0.32 →
# CAGR +29.7% при просадке 31.4% (mark-to-market), Sharpe 1.07.
# TREND_PORTFOLIO_ENABLE=1
# Фильтр режима: вход только если BTC выше своей N-дневной средней.
# Гейт стоит ~1 п.п. CAGR и снимает ~5 п.п. просадки.
# TREND_PORTFOLIO_REGIME=BTC
# TREND_PORTFOLIO_REGIME_MA=200
# Риск на сделку = RISK / 45.  Просадка считается по mark-to-market
# (включая открытые позиции): 0.20 → 24.3% DD (CAGR 20.9%), 0.32 → 31.4%
# (29.7%), 0.64 → 44.0% (46.3%).  Прежняя цифра «~22% DD при 0.64» была
# посчитана только по закрытым сделкам и занижала риск вдвое.
# TREND_PORTFOLIO_RISK=0.32
# Тормоз по просадке (по умолчанию ВЫКЛ): когда equity на 20% ниже пика,
# НОВЫЕ входы режутся вдвое, пока просадка не вернётся ниже 10%.  Открытые
# позиции не трогаются.  При risk 0.64: DD 44.0% → 32.4%, но CAGR 46.3% →
# 35.5% и Sharpe 1.10 → 1.04 — это обмен просадки на доходность, не
# улучшение, поэтому в боевом профиле тормоз не включён.
# TREND_PORTFOLIO_BRAKE_START=0
# TREND_PORTFOLIO_BRAKE_MULT=0.5
# TREND_PORTFOLIO_BRAKE_RECOVER=0
# TREND_PORTFOLIO_ENTRY=40
# TREND_PORTFOLIO_EXIT=20
# TREND_PORTFOLIO_CHANDELIER=5.0
# TREND_PORTFOLIO_SIZING_HALFLIFE=365
# TREND_PORTFOLIO_POLL=3600
# Состояние книги пишется в БД (settings.trend_portfolio_state), поэтому
# форвард-рекорд переживает рестарт/редеплой Render; файл в контейнере —
# только фолбэк.  В /api/health видно trend_data.store (postgres|sqlite|file)
# и live_since — с какого момента считается честный форвард.
# Биржа дневных баров: binance_vision (по умолчанию), binance или okx.
# Важно: OKX режет сутки по UTC+8, Binance — по UTC. На тех же правилах
# 2023-08→2026-11 даёт 14% CAGR / Sharpe 0.57 (OKX) против 24% / 0.85
# (Binance), т.е. венью — часть стратегии, а не деталь реализации.
# binance_vision — публичное зеркало тех же UTC-свечей: отдаёт все 45 монет
# с облачных хостов, где api.binance.com отвечает 451, а OKX лимитирует
# общий IP после ~26 запросов. Внутри цикла есть цепочка фолбэков
# (binance_vision → okx → binance), но стабильная книга должна жить на
# одной бирже.
# TREND_PORTFOLIO_SOURCE=binance_vision

# ── Core-портфель (paper-only, только чтение) ──
# Две независимые бумажные книги по 50% капитала:
#   • дневная — Donchian 40/20 + Chandelier 5xATR, риск 0.64/слот, гейт BTC200;
#   • 6h      — Donchian 80/40 (6-часовые бары) + Chandelier 3.5xATR,
#               риск 0.05/слот, тот же гейт.
# Ордеров нет: только публичные свечи. По умолчанию ВЫКЛ.
# Честный бэктест 2021-06 → 2026-11 (издержки 0.16%/сторона, два счёта):
#   дневная 28.7% CAGR / DD 22.9% / Sharpe 1.18
#   6h      10.1% CAGR / DD 13.5% / Sharpe 1.01 (на 8 годах: 11.7% / 13.5% / 1.23)
#   бленд   21.0% CAGR / DD 14.9% / Sharpe 1.42, корреляция блоков -0.01
# CORE_PORTFOLIO_ENABLE=1
# CORE_PORTFOLIO_CAPITAL=10000
# CORE_PORTFOLIO_DAILY_WEIGHT=0.5
# CORE_PORTFOLIO_H6_ENTRY=80
# CORE_PORTFOLIO_H6_EXIT=40
# CORE_PORTFOLIO_H6_ATR=14
# CORE_PORTFOLIO_H6_CHANDELIER=3.5
# CORE_PORTFOLIO_H6_RISK=0.05
# CORE_PORTFOLIO_H6_MAX_LEV=2.0
# CORE_PORTFOLIO_DAILY_RISK=0.64
# CORE_PORTFOLIO_DAILY_ENTRY=40
# CORE_PORTFOLIO_DAILY_EXIT=20
# CORE_PORTFOLIO_DAILY_CHANDELIER=5.0
# CORE_PORTFOLIO_REGIME=BTC
# CORE_PORTFOLIO_REGIME_MA=200
# CORE_PORTFOLIO_POLL=1800
# Венью: okx | binance | binance_vision. Для 6h нужен UTC (Binance), потому
# что OKX режет 6H по UTC+8. Поэтому при CORE_PORTFOLIO_SOURCE=binance
# 6h-блок перебирает только binance → binance_vision, а при недоступности
# обоих пропускает цикл (в data_note будет причина). OKX для 6h берётся
# только если явно указать CORE_PORTFOLIO_SOURCE=okx — это уже другая
# стратегия (другое бакетирование). Дневная книга может падать в OKX.
# CORE_PORTFOLIO_SOURCE=binance

# ── Прочее ──
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# ENABLE_DOCS=false                      # Swagger UI (/docs) — держать выключенным в проде
# DATA_DIR=/tmp                          # каталог для чёрного списка JWT и журналов
# ANALYSIS_LOG_PATH=                     # путь JSONL-журнала решений AI
# PNL_TZ=Europe/Moscow
# ORPHAN_CLOSE=1                         # закрывать «осиротевшие» позиции на бирже
# RESET_TRADING_STATS=                   # одноразовый сброс статистики при старте
# TRACKER_INTERVAL_SEC=600               # период снапшотов equity
#
# Режим продукта (AI Discretionary — единственная стратегия) задан в коде:
# AI_ONLY_MODE жёстко включён в backend/app/main.py, переменной окружения нет.
