# OKX API Credentials (store locally, NEVER commit to git)
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here

# Demo mode: true = demo/simulated trading, false = real trading
OKX_DEMO=true

# Backend config
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# JWT secret for local session (change this)
SESSION_SECRET=change-me-to-random-string

# Fernet key for encrypting auth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a random per-process key is used (all sessions invalidate on restart).
# TOKEN_ENCRYPTION_KEY=

# Allowed CORS origins (comma-separated). Frontend is served same-origin by the
# backend, so this is only needed for separate dev setups.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Set to true to expose /docs (Swagger UI). Keep off in production.
# ENABLE_DOCS=false

# Neon PostgreSQL (for Render deployment)
# Get free connection string at https://console.neon.tech
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/trading?sslmode=require

# Dashboard password (for Render deployment).
# If set, users must enter this password to access dashboard controls.
# Guest mode (read-only) is available without password.
# DASHBOARD_PASSWORD=your_password_here

# Telegram trade notifications.
# Create a bot via @BotFather, get the token, then find your chat_id
# (e.g. via @userinfobot or @getmyid_bot).
# TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken
# TELEGRAM_CHAT_ID=123456789

# Paid signals (Telegram Stars) — private channel where trade signals are
# broadcast to paying subscribers. The bot must be an ADMIN of this channel
# with the "Invite users" permission so it can issue invite links after payment.
# Channel id format: -100XXXXXXXXXX (from @getmyid_bot) or @channelusername.
# TELEGRAM_CHANNEL_ID=-1001234567890

# Paid subscription product config (Stars are Telegram's native currency).
# SIGNAL_PRICE_STARS=100      # stars per period (~30% fee goes to Telegram)
# SIGNAL_PLAN_DAYS=30         # subscription period in days
# SIGNAL_INVITE_DAYS=3        # invite-link validity after payment
# SIGNAL_PLAN_LABEL=Подписка на сигналы 1 мес

# Pro plan — mini-app + user's own OKX account, bots auto-trade for them.
# PRO_PRICE_STARS=500         # stars per Pro period
# PRO_PLAN_DAYS=30            # Pro period in days
# PRO_PLAN_LABEL=Pro-тариф: мини-ап + свой счёт OKX 1 мес

# Public tracker URL (for the "Live results" button in the bot menu).
# TRACKER_URL=https://your-app.onrender.com/tracker
