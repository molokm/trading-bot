# ─────────────────────────────────────────────────────────────────────────────
# COPIX — переменные окружения (шаблон). Скопируйте в backend/.env и заполните.
# Полное описание интеграций — docs/ARCHITECTURE.md
# ─────────────────────────────────────────────────────────────────────────────

# ── OKX (единственная биржа) ──
# Ключи НИКОГДА не коммитить. Права: чтение + торговля (без вывода средств).
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here
# true = demo/simulated trading, false = реальные деньги
OKX_DEMO=true

# ── Backend ──
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
# Разрешить ручные ордера через /api/trade/order (по умолчанию запрещено)
# ALLOW_MANUAL_ORDERS=0

# ── Секреты, сессии, шифрование ──
# JWT для сессий (24 ч) — переживает рестарт и «сон» Render, если секрет стабилен.
# JWT_SECRET=
# Fernet-ключ для шифрования OKX-ключей пользователей в БД.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если не задан — ключ детерминированно выводится из JWT_SECRET или DASHBOARD_PASSWORD;
# если нет ни одного из трёх — сервис НЕ стартует (fail-closed).
# ⚠ Смена DASHBOARD_PASSWORD/JWT_SECRET при незаданном TOKEN_ENCRYPTION_KEY делает
#   ранее сохранённые ключи пользователей нечитаемыми.
TOKEN_ENCRYPTION_KEY=
# REQUIRE_ENCRYPTION_KEY=1   # требовать TOKEN_ENCRYPTION_KEY явно
DASHBOARD_PASSWORD=your_password_here
# Сессии только в cookie (JWT не возвращается в теле ответа логина)
# COOKIE_ONLY_AUTH=0
# AUTH_COOKIE_SECURE=1
# AUTH_COOKIE_SAMESITE=lax

# ── База данных ──
# Пусто → локальный SQLite (backend/data/trading.db).
# Прод: Neon PostgreSQL, строка с sslmode=require.
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/trading?sslmode=require

# ── Telegram ──
# Бот создаётся через @BotFather; chat_id — через @userinfobot.
# TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken
# TELEGRAM_CHAT_ID=123456789
# Канал бесплатных сигналов (бот должен быть админом с правом приглашать)
# TELEGRAM_CHANNEL_ID=-1001234567890

# ── Подписки (Telegram Stars) ──
# Тариф Pro: мини-ап + торговля на своём счёте OKX. Тариф «Сигналы» выведен.
# PRO_PRICE_STARS=500
# PRO_PLAN_DAYS=30
# PRO_PLAN_LABEL=Pro-тариф: мини-ап + свой счёт OKX 1 мес

# ── Риск-контроль (0 = лимит выключен) ──
# RISK_KILL_SWITCH=false
# RISK_MAX_DAILY_LOSS_USD=0
# RISK_MAX_POSITION_USD=0
# RISK_MAX_LEVERAGE=0
# Позиционные лимиты (этап 5)
# RISK_MAX_OPEN_POSITIONS=0
# RISK_MAX_POS_PER_SYMBOL=0
# RISK_MAX_CORRELATED_EXPOSURE_USD=0

# ── AI Discretionary 1H (LLM) ──
# Провайдеры: groq (primary) → openrouter → openai; без ключей — mock.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_LLM_PROVIDER=groq
# AI_LLM_MODEL=openai/gpt-oss-20b
# AI_LLM_FALLBACKS=openrouter,openai
# AI_LLM_PAYLOAD_CHARS=6000
# AI_FORCE_MODEL=
# AI_ALLOW_LARGE_MODEL=0
# Исполнение ордеров: 0 → только решения и логи (на demo разрешается автоматически)
# AI_EXECUTE=0
# AI_CAPITAL=10000
# AI_MAX_LEVERAGE=3
# AI_MAX_POSITIONS=2  # 2 = second slot (gated: green 1st trade + uncorrelated + align>=0.85)
# AI_RISK_PER_TRADE=0.012
# AI_POLL_SEC=60
# AI_AUTO_START=1
# AI_FORCE_AUTOSTART=
# AI_PERSIST_USER_STOP=1
# Дебаты bull/bear на втором проходе LLM (заменяют повторный опрос, не дороже).
# 0 → обычный self-consistency.
# AI_DEBATE=1

# ── Автостарт ботов ──
# BOTS_AUTO_START=1     # общий выключатель автостарта
# MOM_AUTO_START=0      # Momentum — retired
# IMP_AUTO_START=0      # Impulse — retired
# VAL_AUTO_START=0      # Validation — retired
# SM_AUTO_START=0       # Smart Money — retired

# ── Прочее ──
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# ENABLE_DOCS=false                      # Swagger UI (/docs) — держать выключенным в проде
# DATA_DIR=/tmp                          # каталог для чёрного списка JWT и журналов
# ANALYSIS_LOG_PATH=                     # путь JSONL-журнала решений AI
# PNL_TZ=Europe/Moscow
# ORPHAN_CLOSE=1                         # закрывать «осиротевшие» позиции на бирже
# RESET_TRADING_STATS=                   # одноразовый сброс статистики при старте
# TRACKER_INTERVAL_SEC=600               # период снапшотов equity
#
# Режим продукта (AI Discretionary — единственная стратегия) задан в коде:
# AI_ONLY_MODE жёстко включён в backend/app/main.py, переменной окружения нет.
